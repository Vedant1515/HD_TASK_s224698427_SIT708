<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="40dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_nutriai_logo"
                android:background="@drawable/bg_logo_circle"
                android:padding="16dp"
                android:elevation="4dp"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnPrimary"
                android:paddingTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signup_subtitle"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="24dp"
            app:cardElevation="8dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_create_account"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:paddingBottom="20dp" />

                <!-- Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_name"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextSecondary"
                    android:letterSpacing="0.05"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_name"
                    android:inputType="textPersonName"
                    android:background="@drawable/bg_input_field"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextHint"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextSecondary"
                    android:letterSpacing="0.05"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/bg_input_field"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextHint"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextSecondary"
                    android:letterSpacing="0.05"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_password_signup"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input_field"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextHint"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <!-- Confirm Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_confirm_password"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextSecondary"
                    android:letterSpacing="0.05"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_confirm_password"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input_field"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextHint"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />

                <View android:layout_width="match_parent" android:layout_height="24dp" />

                <!-- Sign Up Button -->
                <Button
                    android:id="@+id/btnSignup"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/btn_signup"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:stateListAnimator="@null"
                    android:elevation="4dp" />

                <!-- Error text -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/colorError"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:visibility="gone" />

                <!-- Login link -->
                <TextView
                    android:id="@+id/tvGoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/link_go_login"
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
