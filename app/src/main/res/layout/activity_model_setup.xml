<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Branded header (matches login / profile) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="40dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_nutriai_logo"
                android:background="@drawable/bg_logo_circle"
                android:padding="16dp"
                android:elevation="4dp"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnPrimary"
                android:paddingTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One-time AI model setup"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:paddingTop="4dp" />

        </LinearLayout>

        <!-- ── Option A: ADB / USB copy ─────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="12dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Option A — Copy via ADB or USB"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push both files to the path shown below, then tap Detect:"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:paddingBottom="10dp" />

                <!-- ADB command block -->
                <TextView
                    android:id="@+id/tvAdbCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@color/colorBackground"
                    android:padding="12dp"
                    android:lineSpacingExtra="4dp" />

                <Button
                    android:id="@+id/btnAutoDetect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Detect files"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Option B: File picker ─────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Option B — Browse for files"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select each file from anywhere on this device. Nothing is copied — the app reads files in-place."
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:paddingBottom="16dp" />

                <!-- Model row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Model  (.pte, ~2.3 GB)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tvModelStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not selected"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPickModel"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Browse…"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginBottom="10dp" />

                <!-- Tokenizer row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tokenizer  (.model, ~2 MB)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tvTokenizerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not selected"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPickTokenizer"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Browse…"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Continue button -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:text="Continue to NutriAI"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:enabled="false"
            android:alpha="0.5" />

        <!-- Demo mode link -->
        <TextView
            android:id="@+id/tvDemoMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue in Demo Mode (no real AI)"
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="32dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
