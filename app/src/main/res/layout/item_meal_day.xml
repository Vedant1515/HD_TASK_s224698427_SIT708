<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Day header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Day number badge -->
            <TextView
                android:id="@+id/tvDayHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorOnPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- BREAKFAST -->
        <LinearLayout
            android:id="@+id/rowBreakfast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Breakfast indicator: green -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="38dp"
                    android:background="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BREAKFAST"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBreakfastName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalBreakfast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/chevronBreakfast"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ingredientsBreakfast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="58dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp" />

        <!-- LUNCH -->
        <LinearLayout
            android:id="@+id/rowLunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Lunch indicator: blue -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="38dp"
                    android:background="#2196F3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LUNCH"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textColor="#2196F3"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLunchName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalLunch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#2196F3"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/chevronLunch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#2196F3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ingredientsLunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="58dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp" />

        <!-- DINNER -->
        <LinearLayout
            android:id="@+id/rowDinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Dinner indicator: purple -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="38dp"
                    android:background="#7B1FA2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DINNER"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textColor="#7B1FA2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDinnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalDinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#7B1FA2"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/chevronDinner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#7B1FA2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ingredientsDinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="58dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp" />

        <!-- SNACK -->
        <LinearLayout
            android:id="@+id/rowSnack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Snack indicator: amber -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="38dp"
                    android:background="#F57C00" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SNACK"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textColor="#F57C00"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSnackName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalSnack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#F57C00"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/chevronSnack"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#F57C00" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ingredientsSnack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="58dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
